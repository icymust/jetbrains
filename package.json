{
  "name": "jetbrains-backend-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "fastify": "^5.0.0",
    "openai": "^7.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
